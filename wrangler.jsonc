{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thenorthofoncopathology",
  "compatibility_date": "2026-09-09",

  // Sin "main": el Worker no ejecuta código, solo sirve archivos. Las peticiones
  // no salen de la ruta rápida de assets de Cloudflare, así que no hay arranque
  // en frío ni CPU facturable.
  "assets": {
    "directory": "./dist/",

    // El sitio solo publica la portada. Las rutas inexistentes deben responder
    // con un 404 real para evitar que Google las trate como soft 404.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
